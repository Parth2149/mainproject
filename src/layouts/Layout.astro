---
import { Header, Footer, Background } from '../components/Chrome.jsx';
import Site from '../components/Site.jsx';
import Breadcrumbs from '../components/Breadcrumbs.jsx';
import { canonical, href, schemaFor, metaDescription, keywordsFor } from '../lib/catalog';
const { page } = Astro.props;
const schema = schemaFor(page);
const description = metaDescription(page.description);
const keywords = keywordsFor(page);
const script = page.kind === 'directory' ? 'directory.js' : page.kind === 'submit' ? 'submit.js' : null;
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-TXZQLP2R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{page.title} | RevKit</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical(page.route)} />
    <meta name="robots" content={page.kind === '404' ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${page.title} | RevKit`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical(page.route)} />
    <meta property="og:image" content={canonical('/assets/og.png')} />
    <meta property="og:image:alt" content="RevKit — curated reverse engineering tools and GitHub repositories" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${page.title} | RevKit`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={canonical('/assets/og.png')} />
    <meta name="twitter:image:alt" content="RevKit — curated reverse engineering tools and GitHub repositories" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="48x48" href={href('/icon-48.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={href('/icon-96.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={href('/icon-192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />
    <link rel="icon" sizes="any" href={href('/favicon.ico')} />
    <link rel="shortcut icon" href={href('/favicon.ico')} />
    <link rel="stylesheet" href={href('/assets/style.css?v=16')} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Background />
    <div class="site-content">
      <Header route={page.route} />
      <main id="main" class="shell"><Breadcrumbs page={page} /><Site page={page} /></main>
      <Footer />
    </div>
    {script && <script is:inline src={href(`/assets/${script}`)} defer />}
  </body>
</html>
